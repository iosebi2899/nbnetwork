---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import PageHero from '../../components/PageHero.astro';
import PlaceSearch from '../../components/PlaceSearch.astro';
import PlaceLinks from '../../components/PlaceLinks.astro';
import CoverageMap from '../../components/CoverageMap.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import { MUNICIPALITIES, PLACES, REGION, municipalityUrl, placesIn } from '../../data/places';
import { SITE } from '../../data/site';
import { areaService, breadcrumbs, type Crumb } from '../../data/schema';

const crumbs: Crumb[] = [
  { name: 'მთავარი', href: '/' },
  { name: 'დაფარვა', href: '/internet/' },
];
---

<Base
  title={`დაფარვის ზონა — ინტერნეტი ${REGION.loc}, ${PLACES.length} დასახლება | NB Networks`}
  description={`ინტერნეტის შემოყვანა ${REGION.loc}: დუშეთის, მცხეთის, თიანეთის და ყაზბეგის მუნიციპალიტეტების ${PLACES.length} დასახლება. მოძებნეთ თქვენი სოფელი, ქალაქი ან დაბა. ☎ ${SITE.phoneDisplay}`}
  schema={[breadcrumbs(crumbs), areaService(REGION.name, REGION.loc, '/internet/')]}
>
  <div class="page">
    <Header />
    <main>
      <PageHero
        crumbs={crumbs}
        title={`ინტერნეტი ${REGION.loc}`}
        lead="ინტერნეტ პროვაიდერი NB Networks — დაფარვის ზონა. მოძებნეთ თქვენი სოფელი, ქალაქი ან დაბა და გაიგეთ, როგორ შემოგიყვანოთ ინტერნეტი."
        note={`Internet in ${REGION.latin}: Dusheti, Mtskheta, Tianeti, Kazbegi`}
      />

      <section class="list container" aria-label="დასახლებების სია">
        <div class="bar">
          <PlaceSearch live />
          <p class="count"><span data-count>{PLACES.length}</span> დასახლება</p>
        </div>

        <CoverageMap />

        <p class="empty" data-empty hidden>
          ვერ მოიძებნა? დაგვირეკეთ <a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a> — გადავამოწმებთ თქვენს დასახლებას.
        </p>

        {
          MUNICIPALITIES.map((m) => (
            <div class="group" data-group>
              <h2 class="h3">
                <a href={municipalityUrl(m.key)}>ინტერნეტი {m.loc}</a>
              </h2>
              <PlaceLinks places={placesIn(m.key)} searchable />
            </div>
          ))
        }
      </section>

      <Contact />
    </main>
    <Footer />
  </div>
</Base>

<script>
  import { initFilter } from '../../scripts/filter';
  initFilter();
</script>

<style>
  .list {
    padding: 48px 20px 72px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    justify-content: space-between;
  }
  .count {
    margin: 0;
    font-size: 14px;
    color: var(--muted);
  }
  .count span {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--navy);
  }
  .empty {
    margin: 0;
    padding: 20px 24px;
    border-radius: 16px;
    background: #fff;
    border: 1px solid var(--line);
    font-size: 15px;
  }
  .group {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .h3 {
    margin: 0;
    font-size: 22px;
    font-weight: 800;
  }
  .h3 a {
    color: var(--navy);
  }
  .h3 a:hover {
    color: var(--magenta);
  }
  [hidden] {
    display: none !important;
  }
</style>
