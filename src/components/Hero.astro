---
import { SITE } from '../data/site';
---

<section id="top" class="hero">
  <div class="glow" aria-hidden="true"></div>
  <div class="inner">
    <div class="copy">
      <span class="badge"><span class="dot" aria-hidden="true"></span>24/7</span>
      <h1>ინტერნეტ პროვაიდერი <span class="accent">დუშეთისა და მცხეთა მთიანეთის რაიონში</span></h1>
      <p>მაღალ ხარისხიანი სტაბილური ინტერნეტი · ქსელისა და WI-FI-ს ინსტალაცია/მონტაჟი</p>
      <div class="ctas">
        <a href="#packages" class="btn btn-light">ინტერნეტ პაკეტები</a>
        <a href={`tel:${SITE.phone}`} class="btn btn-ghost">დაგვიკავშირდით</a>
      </div>
    </div>

    <div class="visual" aria-hidden="true">
      <div class="dots"></div>
      <div class="ring r1"></div>
      <div class="ring r2"></div>
      <div class="ring r3"></div>
      <div class="ring r4"></div>
      <div class="core"></div>
      <div class="stats">
        <div class="speed"><span class="num">50</span><span class="unit">Mbps</span></div>
        <div class="tags">WI-FI · Optic · Satellite</div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--navy);
    color: #fff;
    position: relative;
    overflow: hidden;
  }
  .glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(900px 420px at 85% 10%, rgba(176, 38, 201, 0.28), transparent 60%),
      radial-gradient(700px 400px at 0% 100%, rgba(70, 110, 255, 0.18), transparent 60%);
    pointer-events: none;
  }
  .inner {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    padding: 88px 20px 96px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 48px;
    align-items: center;
  }
  .copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .badge {
    align-self: flex-start;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    font-size: 13px;
    font-weight: 600;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
  }
  h1 {
    margin: 0;
    font-size: 52px;
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: -0.5px;
    text-wrap: balance;
  }
  .accent {
    color: var(--pink);
  }
  p {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--on-dark-2);
    max-width: 520px;
    text-wrap: pretty;
  }
  .ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .btn {
    display: flex;
    align-items: center;
    height: 52px;
    padding: 0 26px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 15px;
  }
  .btn-light {
    background: #fff;
    color: var(--navy);
  }
  .btn-light:hover {
    background: #f0e3f4;
    color: var(--navy);
  }
  .btn-ghost {
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #fff;
  }
  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  .visual {
    position: relative;
    height: 420px;
    border-radius: 24px;
    overflow: hidden;
    background: linear-gradient(160deg, var(--navy-2) 0%, var(--navy-3) 100%);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  .dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px);
    background-size: 22px 22px;
  }
  .ring {
    position: absolute;
    border-radius: 50%;
    border-style: solid;
    border-color: transparent;
    transform: rotate(45deg);
  }
  .r1 {
    left: calc(12% - 380px);
    bottom: calc(14% - 380px);
    width: 760px;
    height: 760px;
    border-width: 2px;
    border-top-color: rgba(255, 255, 255, 0.06);
  }
  .r2 {
    left: calc(12% - 290px);
    bottom: calc(14% - 290px);
    width: 580px;
    height: 580px;
    border-width: 3px;
    border-top-color: rgba(176, 38, 201, 0.35);
  }
  .r3 {
    left: calc(12% - 200px);
    bottom: calc(14% - 200px);
    width: 400px;
    height: 400px;
    border-width: 6px;
    border-top-color: rgba(255, 255, 255, 0.55);
  }
  .r4 {
    left: calc(12% - 110px);
    bottom: calc(14% - 110px);
    width: 220px;
    height: 220px;
    border-width: 8px;
    border-top-color: var(--magenta);
  }
  .core {
    position: absolute;
    left: calc(12% - 18px);
    bottom: calc(14% - 18px);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--pink);
    box-shadow:
      0 0 0 10px rgba(229, 140, 245, 0.18),
      0 0 40px rgba(229, 140, 245, 0.6);
  }
  .stats {
    position: absolute;
    right: 24px;
    top: 24px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
  }
  .speed {
    display: flex;
    align-items: baseline;
    gap: 6px;
    padding: 12px 18px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-family: var(--font-display);
  }
  .num {
    font-size: 34px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -1px;
  }
  .unit {
    font-size: 15px;
    font-weight: 500;
    color: var(--on-dark-2);
  }
  .tags {
    padding: 8px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.16);
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
  }

  @media (max-width: 819px) {
    h1 {
      font-size: 40px;
    }
  }
  @media (max-width: 559px) {
    .inner {
      padding: 48px 20px 56px;
    }
    h1 {
      font-size: 32px;
    }
    .visual {
      height: 240px;
    }
  }
</style>
