---
interface Props {
  /** When true, the input also filters the list on the current page (hub). */
  live?: boolean;
  dark?: boolean;
}
const { live = false, dark = false } = Astro.props;
const id = live ? 'q-live' : 'q';
---

<form
  action="/internet/"
  method="get"
  role="search"
  class:list={['search', { dark }]}
  data-autocomplete
  data-place-search={live ? '' : undefined}
>
  <div class="field">
    <label for={id} class="sr-only">მოძებნეთ სოფელი, ქალაქი ან დაბა</label>
    <input
      id={id}
      name="q"
      type="search"
      autocomplete="off"
      spellcheck="false"
      placeholder="სოფელი, ქალაქი ან დაბა — მაგ. ჭოპორტი, დუშეთი, ტონჩა"
    />
    <button type="submit">შემოწმება</button>
  </div>
  <ul class="ac" role="listbox" aria-label="შედეგები" data-ac-list hidden></ul>
</form>

<script>
  import { initAutocomplete } from '../scripts/autocomplete';
  initAutocomplete();
</script>

<style>
  .search {
    position: relative;
    max-width: 640px;
    width: 100%;
  }
  .field {
    display: flex;
    gap: 8px;
    padding: 6px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--line);
    transition:
      border-color var(--ease),
      box-shadow var(--ease);
  }
  .dark .field {
    border-color: transparent;
    box-shadow: 0 12px 32px rgba(20, 26, 58, 0.18);
  }
  .field:focus-within {
    border-color: var(--magenta);
    box-shadow: 0 0 0 4px rgba(176, 38, 201, 0.12);
  }
  input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    padding: 0 16px;
    font: inherit;
    font-size: 15px;
    color: var(--navy);
  }
  input:focus-visible {
    outline: 0;
  }
  input::placeholder {
    color: var(--muted);
  }
  button {
    flex: none;
    height: 46px;
    padding: 0 22px;
    border: 0;
    border-radius: 999px;
    background: var(--magenta);
    color: #fff;
    font: inherit;
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
  }
  button:hover {
    background: var(--magenta-dark);
  }

  .ac {
    position: absolute;
    z-index: 30;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    margin: 0;
    padding: 6px;
    list-style: none;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 18px;
    box-shadow: 0 16px 40px rgba(20, 26, 58, 0.16);
    max-height: 360px;
    overflow-y: auto;
  }
  .ac[hidden] {
    display: none;
  }
  .ac :global([role='option']) {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 14px;
    border-radius: 12px;
    cursor: pointer;
    transition: background-color var(--ease);
  }
  .ac :global([role='option'][aria-selected='true']) {
    background: #f7e8fa;
  }
  .ac :global(.ac-name) {
    font-weight: 700;
    font-size: 15px;
    color: var(--navy);
  }
  .ac :global(.ac-meta) {
    font-size: 13px;
    color: var(--muted);
  }
  .ac :global(.ac-ok) {
    margin-left: auto;
    padding: 3px 10px;
    border-radius: 999px;
    background: rgba(61, 220, 151, 0.15);
    color: #178a58;
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
  }
  .ac :global(.ac-empty) {
    padding: 12px 14px;
    font-size: 14px;
    color: var(--text-2);
  }

  @media (max-width: 559px) {
    input {
      padding: 0 10px;
      font-size: 14px;
    }
    button {
      padding: 0 16px;
    }
    .ac :global(.ac-meta) {
      display: none;
    }
  }
</style>
