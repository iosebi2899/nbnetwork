---
import { placeUrl, type Place } from '../data/places';

interface Props {
  places: Place[];
  /** Extra text per place, e.g. distance. */
  meta?: (p: Place) => string | undefined;
  /** Adds data attributes used by the live search filter. */
  searchable?: boolean;
}

const { places, meta, searchable = false } = Astro.props;
const searchKey = (p: Place): string => [p.name, p.latin, p.alt ?? ''].join(' ').toLowerCase();
---

<ul class="links">
  {
    places.map((p) => {
      const extra = meta?.(p);
      return (
        <li data-place={searchable ? searchKey(p) : undefined}>
          <a href={placeUrl(p)}>
            {p.name}
            {extra && <span class="meta">{extra}</span>}
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  a {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--line);
    color: var(--navy);
    font-size: 14px;
    font-weight: 600;
  }
  a:hover {
    border-color: var(--magenta);
    color: var(--magenta);
  }
  .meta {
    font-weight: 500;
    font-size: 12px;
    color: var(--muted);
  }
  [hidden] {
    display: none;
  }
</style>
