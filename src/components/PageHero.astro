---
import { SITE } from '../data/site';
import type { Crumb } from '../data/schema';

interface Props {
  crumbs: Crumb[];
  title: string;
  lead: string;
  /** Small line under the lead, e.g. the Latin name for Latin-script searches. */
  note?: string;
  status?: { ok: boolean; label: string };
}

const { crumbs, title, lead, note, status } = Astro.props;
---

<section class="hero">
  <div class="glow" aria-hidden="true"></div>
  <div class="inner">
    <nav aria-label="breadcrumb">
      <ol class="crumbs">
        {
          crumbs.map((c, i) => (
            <li>
              {i < crumbs.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
            </li>
          ))
        }
      </ol>
    </nav>
    {
      status && (
        <span class:list={['badge', { ok: status.ok }]}>
          <span class="dot" aria-hidden="true" />
          {status.label}
        </span>
      )
    }
    <h1>{title}</h1>
    <p class="lead">{lead}</p>
    {note && <p class="note">{note}</p>}
    <div class="ctas">
      <a href={`tel:${SITE.phone}`} class="btn btn-light">☏ {SITE.phoneDisplay}</a>
      <a href="#packages" class="btn btn-ghost">ინტერნეტ პაკეტები</a>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--navy);
    color: #fff;
    position: relative;
    overflow: hidden;
  }
  .glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(900px 420px at 85% 10%, rgba(176, 38, 201, 0.28), transparent 60%),
      radial-gradient(700px 400px at 0% 100%, rgba(70, 110, 255, 0.18), transparent 60%);
    pointer-events: none;
  }
  .inner {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 20px 72px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .crumbs {
    list-style: none;
    margin: 0 0 12px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 13px;
    color: var(--on-dark-2);
  }
  .crumbs li + li::before {
    content: '›';
    margin-right: 6px;
    opacity: 0.6;
  }
  .crumbs a {
    color: var(--on-dark-2);
  }
  .crumbs a:hover {
    color: #fff;
  }
  .badge {
    align-self: flex-start;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    font-size: 13px;
    font-weight: 600;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #f5b841;
  }
  .badge.ok .dot {
    background: var(--green);
  }
  h1 {
    margin: 0;
    font-size: 52px;
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: -0.5px;
    text-wrap: balance;
    max-width: 900px;
  }
  .lead {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--on-dark-2);
    max-width: 720px;
    text-wrap: pretty;
  }
  .note {
    margin: -8px 0 0;
    font-size: 14px;
    color: rgba(201, 205, 228, 0.7);
  }
  .ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 4px;
  }
  .btn {
    display: flex;
    align-items: center;
    height: 52px;
    padding: 0 26px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 15px;
  }
  .btn-light {
    background: #fff;
    color: var(--navy);
  }
  .btn-light:hover {
    background: #f0e3f4;
    color: var(--navy);
  }
  .btn-ghost {
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #fff;
  }
  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }
  @media (max-width: 819px) {
    h1 {
      font-size: 40px;
    }
  }
  @media (max-width: 559px) {
    .inner {
      padding: 28px 20px 48px;
    }
    h1 {
      font-size: 32px;
    }
  }
</style>
